FROM python:3.10-bookworm
ENV PYTHONUNBUFFERED=1

# Install uv
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

RUN \
  echo "deb https://deb.nodesource.com/node_14.x bookworm main" > /etc/apt/sources.list.d/nodesource.list && \
  wget -qO- https://deb.nodesource.com/gpgkey/nodesource.gpg.key | apt-key add - && \
  apt-get update && \
  apt-get install -yqq nodejs

# copy code files
RUN mkdir /code
COPY . /code/
WORKDIR /code

# Install dependencies with uv (--system installs to system Python, no venv needed in Docker)
RUN uv sync --directory /code/ --frozen --no-dev
