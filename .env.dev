# Environment variables for Docker

DJANGO_SETTINGS_MODULE=commcare_sync.settings_docker

# In production, SECRET_KEY and FERNET_KEYS would be set using
# environment variables, but we'll just use values from settings.py
# SECRET_KEY='s3cret'
# FERNET_KEYS='["current-s3cret", "old-s3cret"]'  # JSON

# Use a Docker-specific virtualenv directory to avoid conflicts with host .venv
UV_PROJECT_ENVIRONMENT=.venv-docker
